---
// Pricing section - Dark mode with Hero DA
import CTAButton from "./CTAButton.astro";
import GridBackground from "./ui/GridBackground.astro";
---

<section
    id="pricing"
    class="relative py-20 md:py-28 bg-zinc-950 overflow-hidden"
>
    <!-- Background effects -->
    <GridBackground opacity={3} />
    <div class="absolute top-1/4 right-1/4 w-100 h-100 bg-violet-600/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 left-1/4 w-75 h-75 bg-violet-500/10 rounded-full blur-3xl"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,#09090b_70%)]"></div>

    <div class="relative max-w-5xl mx-auto px-4 md:px-6">
        <!-- Header -->
        <div class="text-center mb-12">
            <p
                class="text-violet-400 text-xs font-medium tracking-wider uppercase mb-3"
            >
                Investissement
            </p>
            <h2 class="text-2xl md:text-4xl font-semibold text-white mb-4">
                Combien valent 10h/semaine de votre temps ?
            </h2>
            <p class="text-zinc-400 text-sm md:text-base max-w-lg mx-auto">
                À 50€/h, c'est 500€ économisés chaque semaine.
            </p>
        </div>

        <!-- Toggle -->
        <div
            class="flex items-center justify-center gap-1 bg-zinc-900 border border-zinc-800 rounded-full p-1 max-w-xs mx-auto mb-10"
        >
            <button
                id="btn-normal"
                class="flex-1 text-xs font-medium py-2.5 px-4 rounded-full transition-all bg-white text-zinc-900"
                onclick="switchPricing('normal')"
            >
                Prix normal
            </button>
            <button
                id="btn-cpf"
                class="flex-1 text-xs font-medium py-2.5 px-4 rounded-full transition-all text-zinc-400 hover:text-white"
                onclick="switchPricing('cpf')"
            >
                Avec CPF
            </button>
        </div>

        <!-- Cards container -->
        <div class="max-w-md mx-auto">
            <!-- Normal Price Card -->
            <div id="card-normal" class="pricing-card-wrap">
                <div
                    class="relative p-6 rounded-2xl bg-zinc-900/80 backdrop-blur-sm border border-zinc-800"
                >
                    <!-- Popular badge -->
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                        <span
                            class="inline-flex items-center gap-1.5 text-xs font-medium text-white bg-violet-600 px-4 py-1.5 rounded-full shadow-lg shadow-violet-500/25"
                        >
                            <svg
                                class="w-3.5 h-3.5"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                    clip-rule="evenodd"></path>
                            </svg>
                            Formation complète
                        </span>
                    </div>

                    <!-- Price -->
                    <div class="text-center mt-4 mb-6">
                        <div class="flex items-baseline justify-center gap-2">
                            <span
                                class="text-5xl md:text-6xl font-bold text-white"
                                >499€</span
                            >
                            <span class="text-zinc-500 text-sm">HT</span>
                        </div>
                        <p class="text-sm text-violet-400 mt-2 font-medium">
                            Accès à vie · Mises à jour incluses
                        </p>
                    </div>

                    <!-- Benefits -->
                    <div class="space-y-3 mb-8">
                        {[
                            "+ de 90 leçons vidéo HD",
                            "Projets réels étape par étape",
                            "Exercices corrigés + Quiz",
                            "Templates & scénarios prêts à l'emploi",
                            "Communauté privée + support",
                            "Mises à jour à vie",
                        ].map((benefit) => (
                            <div class="flex items-center gap-3">
                                <div class="w-5 h-5 rounded-full bg-violet-500/20 flex items-center justify-center shrink-0">
                                    <svg class="w-3 h-3 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <span class="text-sm text-zinc-300">{benefit}</span>
                            </div>
                        ))}
                    </div>

                    <!-- CTA -->
                    <CTAButton
                        href="https://lilian.yt/paiementmake?ref=siteweb"
                        fullWidth={true}
                    />

                    <p class="text-center text-xs text-zinc-500 mt-4">
                        Paiement sécurisé · Accès immédiat
                    </p>
                    <p class="text-center text-[10px] text-zinc-600 mt-2">
                        TVA non applicable (Art. 293 B du CGI)
                    </p>
                </div>
            </div>

            <!-- CPF Price Card (hidden by default) -->
            <div id="card-cpf" class="hidden">
                <div
                    class="relative p-8 rounded-2xl bg-zinc-900/80 backdrop-blur-sm border border-emerald-500/30"
                >
                    <!-- Badge -->
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                        <span
                            class="inline-flex items-center gap-1.5 text-xs font-medium text-white bg-emerald-600 px-4 py-1.5 rounded-full shadow-lg shadow-emerald-500/25"
                        >
                            <svg
                                class="w-3.5 h-3.5"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                    clip-rule="evenodd"></path>
                            </svg>
                            Accès à vie
                        </span>
                    </div>

                    <!-- Price -->
                    <div class="text-center mt-4 mb-8">
                        <div class="flex items-baseline justify-center gap-2">
                            <span
                                class="text-5xl md:text-6xl font-bold text-white"
                                >2 590€</span
                            >
                        </div>
                        <p class="text-sm text-emerald-400 mt-2 font-medium">
                            Éligible au financement CPF
                        </p>
                    </div>

                    <!-- Benefits -->
                    <div class="space-y-4 mb-8">
                        <div class="flex items-center gap-3">
                            <div
                                class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center shrink-0"
                            >
                                <svg
                                    class="w-3 h-3 text-emerald-400"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <span class="text-sm text-zinc-300"
                                >Tout le contenu + mises à jour à vie</span
                            >
                        </div>
                        <div class="flex items-center gap-3">
                            <div
                                class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center shrink-0"
                            >
                                <svg
                                    class="w-3 h-3 text-emerald-400"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <span class="text-sm text-zinc-300"
                                >Certification officielle incluse</span
                            >
                        </div>
                        <div class="flex items-center gap-3">
                            <div
                                class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center shrink-0"
                            >
                                <svg
                                    class="w-3 h-3 text-emerald-400"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <span class="text-sm text-zinc-300"
                                >On gère l'administratif pour vous</span
                            >
                        </div>
                        <div class="flex items-center gap-3">
                            <div
                                class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center shrink-0"
                            >
                                <svg
                                    class="w-3 h-3 text-emerald-400"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <span class="text-sm text-zinc-300"
                                >Communauté + support prioritaire</span
                            >
                        </div>
                    </div>

                    <!-- CTA -->
                    <a
                        href="https://lilian.yt/makecpf?ref=siteweb"
                        class="group block w-full text-center bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-6 py-4 rounded-xl transition-colors"
                    >
                        <span class="flex items-center justify-center gap-2">
                            Je vérifie mon éligibilité
                            <svg
                                class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                            </svg>
                        </span>
                    </a>

                    <p class="text-center text-xs text-zinc-500 mt-4">
                        Sans engagement · Réponse sous 24h
                    </p>
                </div>
            </div>
        </div>

        <!-- Trust badges -->
        <div
            class="flex flex-wrap items-center justify-center gap-6 mt-10 text-zinc-500 text-xs"
        >
            <div class="flex items-center gap-2">
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    ></path>
                </svg>
                <span>Paiement sécurisé</span>
            </div>
            <div class="flex items-center gap-2">
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    ></path>
                </svg>
                <span>Garantie 30 jours</span>
            </div>
            <div class="flex items-center gap-2">
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                <span>Accès immédiat</span>
            </div>
        </div>
    </div>

    <!-- Bottom luminous border -->
    <div class="absolute bottom-0 left-0 right-0">
        <div
            class="h-px bg-linear-to-r from-transparent via-violet-500/40 to-transparent"
        >
        </div>
    </div>
</section>

<script>
    declare global {
        interface Window {
            switchPricing: (type: string) => void;
        }
    }

    function switchPricing(type: string) {
        const cardNormal = document.getElementById("card-normal");
        const cardCpf = document.getElementById("card-cpf");
        const btnNormal = document.getElementById("btn-normal");
        const btnCpf = document.getElementById("btn-cpf");

        if (!cardNormal || !cardCpf || !btnNormal || !btnCpf) return;

        if (type === "normal") {
            cardNormal.classList.remove("hidden");
            cardCpf.classList.add("hidden");
            btnNormal.classList.add("bg-white", "text-zinc-900");
            btnNormal.classList.remove("text-zinc-400");
            btnCpf.classList.remove("bg-white", "text-zinc-900");
            btnCpf.classList.add("text-zinc-400");
        } else {
            cardCpf.classList.remove("hidden");
            cardNormal.classList.add("hidden");
            btnCpf.classList.add("bg-white", "text-zinc-900");
            btnCpf.classList.remove("text-zinc-400");
            btnNormal.classList.remove("bg-white", "text-zinc-900");
            btnNormal.classList.add("text-zinc-400");
        }
    }

    window.switchPricing = switchPricing;
</script>
