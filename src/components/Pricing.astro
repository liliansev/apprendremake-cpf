---
// Pricing section - Toggle above pricing card, benefits with icons
---

<section id="pricing" class="py-16 md:py-24 bg-zinc-50/50">
  <div class="max-w-5xl mx-auto px-4 md:px-6">
    <!-- Header -->
    <div class="text-center mb-12">
      <p class="text-violet-600 text-xs font-medium tracking-wider uppercase mb-3">Investissement</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-zinc-900 mb-3">
        Combien vaut 10h/semaine de votre temps ?
      </h2>
      <p class="text-zinc-500 text-sm max-w-lg mx-auto">
        À 50€/h, c'est 500€ économisés chaque semaine. <span class="text-zinc-700 font-medium">La formation se rembourse en moins de 2 semaines.</span>
      </p>
    </div>

    <!-- Layout with flex for mobile reordering -->
    <div class="flex flex-col lg:grid lg:grid-cols-2 gap-8 items-start">

      <!-- Video preview - hidden on mobile, visible on desktop -->
      <div class="hidden lg:block order-1 lg:order-1">
        <div class="relative aspect-video rounded-2xl bg-zinc-900 overflow-hidden group cursor-pointer shadow-xl">
          <div class="absolute inset-0 bg-gradient-to-br from-violet-600/20 to-transparent"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-16 h-16 rounded-full bg-white/90 flex items-center justify-center group-hover:scale-110 transition-transform shadow-lg">
              <svg class="w-6 h-6 text-zinc-900 ml-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </div>
          <div class="absolute bottom-4 left-4 right-4">
            <p class="text-white/70 text-xs mb-0.5">Aperçu de la formation</p>
            <p class="text-white font-medium text-sm">Découvrez le contenu en 2 min</p>
          </div>
        </div>
      </div>

      <!-- Benefits grid - order 3 mobile (after price), order 2 desktop (below video) -->
      <div class="order-3 lg:order-3">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- Video -->
          <div class="flex items-center gap-3 p-3 rounded-xl bg-white border border-zinc-100">
            <div class="w-9 h-9 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <span class="text-xs text-zinc-700">+ de 90 leçons — de zéro à autonome</span>
          </div>

          <!-- Community -->
          <div class="flex items-center gap-3 p-3 rounded-xl bg-white border border-zinc-100">
            <div class="w-9 h-9 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <span class="text-xs text-zinc-700">Communauté d'entraide active</span>
          </div>

          <!-- Projects -->
          <div class="flex items-center gap-3 p-3 rounded-xl bg-white border border-zinc-100">
            <div class="w-9 h-9 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
            </div>
            <span class="text-xs text-zinc-700">Cas réels d'entrepreneur et freelance</span>
          </div>

          <!-- Updates -->
          <div class="flex items-center gap-3 p-3 rounded-xl bg-white border border-zinc-100">
            <div class="w-9 h-9 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
            </div>
            <span class="text-xs text-zinc-700">Accès à vie + toutes les MAJ</span>
          </div>

          <!-- Support -->
          <div class="flex items-center gap-3 p-3 rounded-xl bg-white border border-zinc-100">
            <div class="w-9 h-9 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <span class="text-xs text-zinc-700">Réponses sous 24h garanties</span>
          </div>
        </div>
      </div>

      <!-- Toggle + Pricing cards - order 2 mobile (after video), order 2 desktop (right column) -->
      <div class="order-2 lg:order-2 lg:row-span-2">
        <!-- Toggle above card -->
        <div class="flex items-center justify-center gap-1 bg-zinc-100 rounded-full p-1 max-w-xs mx-auto mb-4">
          <button
            id="btn-normal"
            class="flex-1 text-xs font-medium py-2.5 px-4 rounded-full transition-all bg-zinc-900 text-white"
            onclick="switchPricing('normal')"
          >
            Prix normal
          </button>
          <button
            id="btn-cpf"
            class="flex-1 text-xs font-medium py-2.5 px-4 rounded-full transition-all text-zinc-500 hover:text-zinc-900"
            onclick="switchPricing('cpf')"
          >
            Avec CPF
          </button>
        </div>

        <!-- Normal Price Card -->
        <div id="card-normal" class="relative p-6 rounded-2xl border border-zinc-200 bg-white">
          <!-- Badge -->
          <div class="mb-4">
            <span class="inline-block text-xs font-medium text-white bg-zinc-900 px-3 py-1 rounded-full">
              Formation complète
            </span>
          </div>

          <!-- Price -->
          <div class="mb-6">
            <div class="flex items-baseline gap-2">
              <span class="text-4xl font-bold text-zinc-900">499€</span>
              <span class="text-zinc-400 text-lg">HT</span>
            </div>
            <p class="text-sm text-zinc-500 mt-1">ou 3× 166€ sans frais</p>
          </div>

          <!-- Benefits -->
          <div class="space-y-3 mb-6">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-violet-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-sm text-zinc-700">Accès immédiat + à vie</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-violet-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-sm text-zinc-700">Communauté + support inclus</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-violet-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-sm text-zinc-700">30 jours satisfait ou remboursé</span>
            </div>
          </div>

          <!-- CTA -->
          <a
            href="https://lilian.yt/paiementmake?ref=siteweb"
            class="group block w-full text-center bg-violet-600 hover:bg-violet-700 text-white font-medium px-6 py-4 rounded-xl transition-colors"
          >
            <span class="flex items-center justify-center gap-2">
              Je deviens autonome sur Make
              <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </span>
          </a>

          <p class="text-center text-xs text-zinc-400 mt-4">
            🔒 Paiement sécurisé · Accès immédiat
          </p>
        </div>

        <!-- CPF Price Card (hidden by default) -->
        <div id="card-cpf" class="relative p-6 rounded-2xl border border-emerald-200 bg-white hidden">
          <!-- Badge -->
          <div class="mb-4">
            <span class="inline-block text-xs font-medium text-white bg-emerald-600 px-3 py-1 rounded-full">
              0€ de votre poche
            </span>
          </div>

          <!-- Price -->
          <div class="mb-6">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-bold text-zinc-900">2 590€</span>
            </div>
            <p class="text-sm text-emerald-600 mt-1 font-medium">Éligible au financement CPF</p>
          </div>

          <!-- Benefits -->
          <div class="space-y-3 mb-6">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-sm text-zinc-700">Tout le contenu + mises à jour à vie</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-sm text-zinc-700">Certification officielle incluse</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-sm text-zinc-700">On gère l'administratif pour vous</span>
            </div>
          </div>

          <!-- CTA -->
          <a
            href="https://lilian.yt/makecpf?ref=siteweb"
            class="group block w-full text-center bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-6 py-4 rounded-xl transition-colors"
          >
            <span class="flex items-center justify-center gap-2">
              Je vérifie mon éligibilité
              <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </span>
          </a>

          <p class="text-center text-xs text-zinc-400 mt-4">
            Sans engagement · Réponse sous 24h
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function switchPricing(type) {
    const cardNormal = document.getElementById('card-normal');
    const cardCpf = document.getElementById('card-cpf');
    const btnNormal = document.getElementById('btn-normal');
    const btnCpf = document.getElementById('btn-cpf');

    if (type === 'normal') {
      cardNormal.classList.remove('hidden');
      cardCpf.classList.add('hidden');
      btnNormal.classList.add('bg-zinc-900', 'text-white');
      btnNormal.classList.remove('text-zinc-500');
      btnCpf.classList.remove('bg-zinc-900', 'text-white');
      btnCpf.classList.add('text-zinc-500');
    } else {
      cardCpf.classList.remove('hidden');
      cardNormal.classList.add('hidden');
      btnCpf.classList.add('bg-zinc-900', 'text-white');
      btnCpf.classList.remove('text-zinc-500');
      btnNormal.classList.remove('bg-zinc-900', 'text-white');
      btnNormal.classList.add('text-zinc-500');
    }
  }

  window.switchPricing = switchPricing;
</script>
