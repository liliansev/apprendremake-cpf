---
// Pricing section - Dark mode
import CTAButton from "./CTAButton.astro";
import GridBackground from "./ui/GridBackground.astro";
---

<section
    id="pricing"
    class="relative py-20 md:py-28 bg-zinc-950 overflow-hidden"
>
    <!-- Background effects -->
    <GridBackground />
    <div class="absolute top-1/4 right-1/4 w-100 h-100 bg-violet-600/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 left-1/4 w-75 h-75 bg-violet-500/10 rounded-full blur-3xl"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,#09090b_70%)]"></div>

    <div class="relative max-w-5xl mx-auto px-4 md:px-6">
        <!-- Header -->
        <div class="text-center mb-12">
            <p
                class="text-emerald-400 text-xs font-medium tracking-wider uppercase mb-3"
            >
                Financement CPF
            </p>
            <h2 class="text-2xl md:text-4xl font-semibold text-white mb-4">
                Investissez dans votre avenir,<br class="hidden sm:block" />pas dans votre portefeuille
            </h2>
            <p class="text-zinc-400 text-sm md:text-base max-w-lg mx-auto">
                Votre reconversion ne devrait pas vous coûter un euro. Utilisez votre CPF pour financer 100% de la formation.
            </p>
        </div>

        <!-- Price Card -->
        <div class="max-w-md mx-auto">
            <div
                class="relative p-6 rounded-2xl bg-zinc-900/80 backdrop-blur-sm border border-zinc-800"
            >
                <!-- Popular badge -->
                <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                    <span
                        class="inline-flex items-center gap-1.5 text-xs font-medium text-white bg-emerald-600 px-4 py-1.5 rounded-full shadow-lg shadow-emerald-500/25"
                    >
                        <svg
                            class="w-3.5 h-3.5"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"></path>
                        </svg>
                        Éligible CPF · RS6228
                    </span>
                </div>

                <!-- Price with anchor -->
                <div class="text-center mt-4 mb-6">
                    <div class="flex items-baseline justify-center gap-3">
                        <span class="text-xl md:text-2xl text-zinc-500 line-through decoration-zinc-600">2 490€</span>
                        <span
                            class="text-5xl md:text-6xl font-bold text-emerald-400"
                            >0€</span
                        >
                        <span class="text-zinc-500 text-sm">pour vous</span>
                    </div>
                    <p class="text-sm text-zinc-400 mt-2 font-medium">
                        100% pris en charge par votre CPF
                    </p>
                    <div class="inline-flex items-center gap-1.5 mt-3 text-amber-400 text-xs font-medium bg-amber-500/10 px-3 py-1.5 rounded-full border border-amber-500/20">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Places limitées — inscriptions ouvertes
                    </div>
                </div>

                <!-- Benefits -->
                <div class="space-y-3 mb-6">
                    {[
                        "+ de 100 vidéos détaillées",
                        "Projets pratiques corrigés",
                        "Certification Make partenaire",
                        "Attestation de fin de formation",
                        "Support par email 7j/7",
                        "Accès 24h/24 · 7j/7",
                    ].map((benefit) => (
                        <div class="flex items-center gap-3">
                            <div class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center shrink-0">
                                <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <span class="sm text-zinc-300">{benefit}</span>
                        </div>
                    ))}
                </div>

                <!-- Bonus -->
                <div class="space-y-2 mb-8 pt-4 border-t border-zinc-800">
                    <p class="text-xs font-medium text-emerald-400 uppercase tracking-wider mb-3">+ Inclus</p>
                    {[
                        "Module Make + IA (ChatGPT, Claude)",
                        "Templates automation prêts à l'emploi",
                        "Accès communauté privée",
                    ].map((bonus) => (
                        <div class="flex items-center gap-3">
                            <div class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center shrink-0">
                                <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <span class="sm text-emerald-200/80">{bonus}</span>
                        </div>
                    ))}
                </div>

                <!-- CTA -->
                <CTAButton
                    href="https://lilian.yt/paiementmake?ref=siteweb"
                    text="Créer mon compte CPF"
                    variant="cpf"
                    fullWidth={true}
                    id="pricing-cta"
                />

                <p class="text-center text-xs text-zinc-500 mt-4">
                    Inscription en 2 minutes · prise en charge à 100% · accès immédiat
                </p>
                <p class="text-center text-[10px] text-zinc-600 mt-2">
                    Formation déclarée sous le code RS6228
                </p>
            </div>
        </div>

        <!-- Trust badges -->
        <div
            class="flex flex-wrap items-center justify-center gap-6 mt-10 text-zinc-500 text-xs"
        >
            <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>100% financé CPF</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                </svg>
                <span>Certification RS6228</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Inscription 2 min</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                <span>Accès immédiat</span>
            </div>
        </div>
    </div>

    <!-- Bottom luminous border -->
    <div class="absolute bottom-0 left-0 right-0">
        <div
            class="h-px bg-linear-to-r from-transparent via-violet-500/40 to-transparent"
        >
        </div>
    </div>
</section>
