---
// Programme section - Conversion optimized with best practices
const phases = [
  {
    id: 1,
    name: "Fondamentaux",
    color: "violet",
    outcome: "Créez vos premiers scénarios automatisés",
    chapters: [
      { title: "Le fonctionnement de Make" },
      { title: "La programmation visuelle" },
      { title: "Formules Basiques" }
    ]
  },
  {
    id: 2,
    name: "Maîtrise",
    color: "blue",
    outcome: "Manipulez les données complexes",
    chapters: [
      { title: "Maîtrise des dates" },
      { title: "Les booléans" },
      { title: "Bonnes pratiques" }
    ]
  },
  {
    id: 3,
    name: "Intégrations",
    color: "emerald",
    outcome: "Connectez n'importe quelle API",
    chapters: [
      { title: "Les APIs" },
      { title: "Les webhooks" },
      { title: "Boucles & Arrays" },
      { title: "Le JSON" }
    ]
  },
  {
    id: 4,
    name: "Expert",
    color: "amber",
    outcome: "Créez des automatisations avancées",
    chapters: [
      { title: "Les aggrégateurs" },
      { title: "Fonctions complexes" },
      { title: "Datastores" }
    ]
  }
];

const finalPhase = {
  id: 5,
  name: "Projet Final",
  color: "rose",
  outcome: "Mettez tout en pratique avec un projet complet de A à Z",
  chapters: [
    { title: "Projet complet" },
    { title: "oAuth 2.0" }
  ]
};

const totalChapters = phases.reduce((acc, phase) => acc + phase.chapters.length, 0) + finalPhase.chapters.length;
---

<section id="programme" class="py-16 md:py-24 bg-gradient-to-b from-white to-zinc-50">
  <div class="max-w-5xl mx-auto px-4 md:px-6">
    <!-- Header -->
    <div class="text-center mb-10">
      <p class="text-violet-600 text-xs font-medium tracking-wider uppercase mb-3">Programme complet</p>
      <h2 class="text-2xl md:text-4xl font-semibold text-zinc-900 mb-3">
        De débutant à expert Make
      </h2>
      <p class="text-zinc-500 text-sm max-w-lg mx-auto mb-6">
        Un parcours structuré en 5 phases pour vous rendre autonome. Chaque chapitre inclut exercices, corrections et quiz.
      </p>

      <!-- Stats pills -->
      <div class="flex flex-wrap items-center justify-center gap-2">
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-600 bg-white border border-zinc-200 px-3 py-1.5 rounded-full">
          <svg class="w-3.5 h-3.5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          {totalChapters} chapitres
        </span>
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-600 bg-white border border-zinc-200 px-3 py-1.5 rounded-full">
          <svg class="w-3.5 h-3.5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          + de 90 leçons
        </span>
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-600 bg-white border border-zinc-200 px-3 py-1.5 rounded-full">
          <svg class="w-3.5 h-3.5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Exercices corrigés
        </span>
      </div>
    </div>

    <!-- Phases 1-4 Grid (2x2) -->
    <div class="grid sm:grid-cols-2 gap-4 mb-4">
      {phases.map((phase) => (
        <div class="relative p-5 rounded-2xl bg-white border border-zinc-200 hover:border-zinc-300 transition-colors">
          <!-- Phase indicator -->
          <div class="flex items-center gap-3 mb-4">
            <div class={`w-8 h-8 rounded-lg flex items-center justify-center text-sm font-bold ${
              phase.color === 'violet' ? 'bg-violet-100 text-violet-600' :
              phase.color === 'blue' ? 'bg-blue-100 text-blue-600' :
              phase.color === 'emerald' ? 'bg-emerald-100 text-emerald-600' :
              'bg-amber-100 text-amber-600'
            }`}>
              {phase.id}
            </div>
            <div>
              <h3 class="text-sm font-semibold text-zinc-900">{phase.name}</h3>
              <p class="text-[11px] text-zinc-400">{phase.chapters.length} chapitres</p>
            </div>
          </div>

          <!-- Outcome -->
          <p class="text-xs text-zinc-600 mb-4 leading-relaxed">{phase.outcome}</p>

          <!-- Chapters - Desktop: visible, Mobile: dropdown -->
          <details class="md:hidden group">
            <summary class="flex items-center justify-between cursor-pointer text-xs text-zinc-500 hover:text-zinc-700">
              <span>Voir les chapitres</span>
              <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="mt-3 space-y-2">
              {phase.chapters.map((chapter) => (
                <div class="flex items-center gap-2 text-xs">
                  <svg class={`w-4 h-4 flex-shrink-0 ${
                    phase.color === 'violet' ? 'text-violet-500' :
                    phase.color === 'blue' ? 'text-blue-500' :
                    phase.color === 'emerald' ? 'text-emerald-500' :
                    'text-amber-500'
                  }`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path>
                  </svg>
                  <span class="text-zinc-700">{chapter.title}</span>
                </div>
              ))}
            </div>
          </details>

          <!-- Chapters - Desktop only -->
          <div class="hidden md:block space-y-2">
            {phase.chapters.map((chapter) => (
              <div class="flex items-center gap-2 text-xs">
                <svg class={`w-4 h-4 flex-shrink-0 ${
                  phase.color === 'violet' ? 'text-violet-500' :
                  phase.color === 'blue' ? 'text-blue-500' :
                  phase.color === 'emerald' ? 'text-emerald-500' :
                  'text-amber-500'
                }`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path>
                </svg>
                <span class="text-zinc-700">{chapter.title}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Phase 5: Final Project (Full width highlight) -->
    <div class="relative p-6 rounded-2xl bg-gradient-to-r from-rose-50 to-orange-50 border border-rose-200">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <!-- Left: Info -->
        <div class="flex-grow">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center text-sm font-bold">
              5
            </div>
            <div>
              <h3 class="text-sm font-semibold text-zinc-900">{finalPhase.name}</h3>
              <p class="text-[11px] text-zinc-400">{finalPhase.chapters.length} chapitres</p>
            </div>
          </div>
          <p class="text-xs text-zinc-600">{finalPhase.outcome}</p>
        </div>

        <!-- Right: Chapters -->
        <div class="flex gap-3 sm:gap-4">
          {finalPhase.chapters.map((chapter) => (
            <div class="flex items-center gap-2 text-xs bg-white/60 px-3 py-2 rounded-lg">
              <svg class="w-4 h-4 text-rose-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path>
              </svg>
              <span class="text-zinc-700">{chapter.title}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-10 text-center">
      <div class="cta-border-wrap w-full sm:w-auto">
        <a
          href="#pricing"
          class="cta-inner w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-violet-600 hover:bg-violet-700 text-white text-sm font-medium px-8 py-3.5 rounded-xl transition-colors"
        >
          <span>Rejoindre la formation</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
      <p class="text-xs text-zinc-400 mt-3">499€/an · Mises à jour à vie · Garantie satisfait 30 jours</p>
    </div>
  </div>
</section>
