---
// Programme section - Full curriculum with accordions
import CTAButton from "./CTAButton.astro";
import { Icon } from 'astro-icon/components';

const chapters = [
  {
    title: "Le fonctionnement de Make",
    color: "violet",
    lessons: [
      "Votre premier scénario sur Make",
      "Les modules sur Make",
      "Déclencher un scénario",
      "Les bundles",
      "Les opérations",
      "Exercice + Correction",
      "Quiz"
    ]
  },
  {
    title: "La programmation visuelle",
    color: "violet",
    lessons: [
      "Introduction aux structures de données",
      "Les filtres",
      "Les routeurs",
      "Les variables",
      "Quiz"
    ]
  },
  {
    title: "Formules Basiques",
    color: "blue",
    lessons: [
      "Les types de données",
      "Formules de texte",
      "INT & FLOAT",
      "Fonctions mathématiques",
      "parseNumber et formatNumber",
      "Quiz"
    ]
  },
  {
    title: "Maîtrise des dates",
    color: "blue",
    lessons: [
      "Introduction aux dates",
      "formatDate et parseDate",
      "Ajouter des valeurs aux dates",
      "Exemples avec cal.com",
      "Quiz"
    ]
  },
  {
    title: "Les booléans",
    color: "blue",
    lessons: [
      "Introduction à la logique",
      "Le type boolean",
      "Exercice + Correction",
      "Quiz"
    ]
  },
  {
    title: "Bonnes pratiques",
    color: "emerald",
    lessons: [
      "Gérer ses connexions",
      "Ranger ses scénarios",
      "Les modules natifs",
      "Exercice : Compresser un fichier",
      "Quiz"
    ]
  },
  {
    title: "Les APIs",
    color: "emerald",
    lessons: [
      "Une API c'est quoi ?",
      "Le module natif HTTP",
      "L'authentification sur une API",
      "La méthode POST",
      "Exercice : Récupérer les données Pappers",
      "Les modules Make an API CALL"
    ]
  },
  {
    title: "Les webhooks",
    color: "emerald",
    lessons: [
      "Introduction aux webhooks",
      "La notion de déclencheur",
      "Les webhooks",
      "Le menu des webhooks",
      "Les mailhooks",
      "Les webhook response",
      "Exercice + Correction"
    ]
  },
  {
    title: "Boucles & Arrays",
    color: "amber",
    lessons: [
      "Les Arrays",
      "Comprendre la structure d'un array",
      "Fonction get()",
      "Fonction map()",
      "Fonction toCollection()",
      "Fonctions d'array complexes",
      "Module natif Iterator",
      "Exercices + Corrections"
    ]
  },
  {
    title: "Le JSON",
    color: "amber",
    lessons: [
      "C'est quoi du JSON",
      "JSON & API",
      "Créer du JSON",
      "Parser du JSON"
    ]
  },
  {
    title: "Les aggrégateurs",
    color: "amber",
    lessons: [
      "Les aggrégateurs",
      "Aggregator & Group by",
      "Agréger du texte",
      "Numeric aggregator",
      "Exemple avec l'API DummyJSON",
      "Array aggregator & TARGET structure",
      "Array aggregator & PARSE JSON",
      "Exercices + Corrections"
    ]
  },
  {
    title: "Fonctions complexes",
    color: "rose",
    lessons: [
      "Fonction indexOf",
      "Fonction substring",
      "Exemple complexe",
      "Formule switch()"
    ]
  },
  {
    title: "Datastores",
    color: "rose",
    lessons: [
      "Introduction au module Datastore",
      "Créez votre base de données",
      "CRUD : Create, Read, Update, Delete",
      "Exercices + Corrections"
    ]
  },
  {
    title: "Projet Final",
    color: "rose",
    lessons: [
      "Projet complet",
      "Correction partie 1",
      "Correction partie 2",
      "Correction partie 3"
    ]
  },
  {
    title: "oAuth 2.0",
    color: "zinc",
    lessons: [
      "Introduction à l'oAuth 2.0",
      "Flow d'authentification",
      "Connexion à OpenStreetMap en oAuth2"
    ]
  }
];

const scenarios = [
  {
    image: "/images/scenarios/crm.png",
    title: "CRM automatisé",
    subtitle: "Notion + Gmail + Calendly",
    description: "Synchronise tes contacts, emails et RDV automatiquement"
  },
  {
    image: "/images/scenarios/facturation.png",
    title: "Facturation auto",
    subtitle: "Stripe → Notion → Email",
    description: "Génère et envoie tes factures en 1 clic"
  },
  {
    image: "/images/scenarios/onboarding.png",
    title: "Onboarding client",
    subtitle: "Typeform → Notion → Slack",
    description: "Accueille chaque nouveau client sans lever le petit doigt"
  },
  {
    image: "/images/scenarios/reporting.png",
    title: "Reporting automatique",
    subtitle: "Sheets → Slack",
    description: "Reçois tes KPIs chaque lundi matin"
  }
];

const exclusiveBonus = [
  { icon: "lucide:briefcase", title: "Projets clients réels", desc: "Coulisses d'automatisations livrées pour de vrais clients" },
  { icon: "lucide:bot", title: "Make + IA", desc: "Intègre ChatGPT et Claude dans tes scénarios" }
];

const colorClasses: Record<string, { bg: string; text: string; border: string; dot: string; accent: string }> = {
  violet: { bg: "bg-violet-50", text: "text-violet-600", border: "border-violet-200", dot: "bg-violet-500", accent: "bg-violet-100" },
  blue: { bg: "bg-blue-50", text: "text-blue-600", border: "border-blue-200", dot: "bg-blue-500", accent: "bg-blue-100" },
  emerald: { bg: "bg-emerald-50", text: "text-emerald-600", border: "border-emerald-200", dot: "bg-emerald-500", accent: "bg-emerald-100" },
  amber: { bg: "bg-amber-50", text: "text-amber-600", border: "border-amber-200", dot: "bg-amber-500", accent: "bg-amber-100" },
  rose: { bg: "bg-rose-50", text: "text-rose-600", border: "border-rose-200", dot: "bg-rose-500", accent: "bg-rose-100" },
  zinc: { bg: "bg-zinc-100", text: "text-zinc-600", border: "border-zinc-300", dot: "bg-zinc-500", accent: "bg-zinc-200" }
};

// Calculate total lessons
const totalLessons = chapters.reduce((acc, ch) => acc + ch.lessons.length, 0);
---

<section id="programme" class="py-16 md:py-24 bg-gradient-to-b from-white to-zinc-50">
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16">
      <p class="text-violet-600 text-xs font-medium tracking-wider uppercase mb-3">Programme complet</p>
      <h2 class="text-2xl md:text-4xl font-semibold text-zinc-900 mb-3">
        De débutant à expert Make
      </h2>
      <p class="text-zinc-500 text-sm md:text-base max-w-xl mx-auto mb-4">
        Un parcours structuré avec exercices, corrections et quiz à chaque étape.
      </p>
      <!-- Stats -->
      <div class="flex items-center justify-center gap-6 text-sm">
        <span class="flex items-center gap-1.5 text-zinc-600">
          <Icon name="lucide:book-open" class="w-4 h-4 text-violet-500" />
          <strong>{chapters.length}</strong> chapitres
        </span>
        <span class="flex items-center gap-1.5 text-zinc-600">
          <Icon name="lucide:play-circle" class="w-4 h-4 text-violet-500" />
          <strong>{totalLessons}+</strong> leçons
        </span>
        <span class="flex items-center gap-1.5 text-zinc-600">
          <Icon name="lucide:clock" class="w-4 h-4 text-violet-500" />
          À ton rythme
        </span>
      </div>
    </div>

    <!-- Main Content -->
    <div class="grid lg:grid-cols-5 gap-8 lg:gap-10">

      <!-- LEFT: Curriculum Accordions (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        {chapters.map((chapter, index) => (
          <details class="group rounded-xl border border-zinc-200 bg-white overflow-hidden hover:border-zinc-300 transition-colors">
            <summary class="flex items-center gap-3 p-4 cursor-pointer list-none select-none">
              <!-- Chapter number badge -->
              <div class={`w-8 h-8 rounded-lg ${colorClasses[chapter.color].bg} ${colorClasses[chapter.color].border} border flex items-center justify-center shrink-0`}>
                <span class={`text-xs font-bold ${colorClasses[chapter.color].text}`}>{index + 1}</span>
              </div>
              <!-- Title -->
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-semibold text-zinc-900 truncate">{chapter.title}</h3>
                <p class="text-xs text-zinc-400">{chapter.lessons.length} leçons</p>
              </div>
              <!-- Arrow -->
              <Icon name="lucide:chevron-down" class="w-4 h-4 text-zinc-400 transition-transform group-open:rotate-180 shrink-0" />
            </summary>

            <!-- Lessons list -->
            <div class="px-4 pb-4 pt-1">
              <div class={`rounded-lg ${colorClasses[chapter.color].bg} p-3`}>
                <ul class="space-y-1.5">
                  {chapter.lessons.map((lesson) => (
                    <li class="flex items-center gap-2 text-xs text-zinc-600">
                      <Icon name="lucide:check" class={`w-3 h-3 ${colorClasses[chapter.color].text} shrink-0`} />
                      <span>{lesson}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </details>
        ))}
      </div>

      <!-- RIGHT: Scenarios + Bonus + CTA (2 cols) -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Scenarios with screenshots -->
        <div>
          <div class="flex items-center gap-2 mb-4">
            <Icon name="lucide:target" class="w-4 h-4 text-violet-600" />
            <h3 class="text-base font-semibold text-zinc-900">Tu sauras créer</h3>
          </div>

          <div class="grid grid-cols-2 gap-3">
            {scenarios.map((scenario) => (
              <div class="group rounded-xl border border-zinc-200 bg-white overflow-hidden hover:border-violet-300 hover:shadow-md transition-all">
                <!-- Screenshot -->
                <div class="aspect-video bg-gradient-to-br from-violet-100 to-zinc-100 relative overflow-hidden">
                  <img
                    src={scenario.image}
                    alt={scenario.title}
                    class="w-full h-full object-cover"
                    onerror="this.style.display='none'"
                  />
                  <div class="absolute inset-0 flex items-center justify-center">
                    <Icon name="lucide:workflow" class="w-6 h-6 text-violet-300" />
                  </div>
                </div>
                <!-- Content -->
                <div class="p-3">
                  <h4 class="text-xs font-semibold text-zinc-900">{scenario.title}</h4>
                  <p class="text-[10px] text-violet-600 font-medium">{scenario.subtitle}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Bonus Exclusifs -->
        <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-xl border border-amber-200 p-5">
          <div class="flex items-center gap-2 mb-3">
            <Icon name="lucide:gift" class="w-4 h-4 text-amber-600" />
            <h3 class="text-sm font-semibold text-zinc-900">Bonus exclusifs</h3>
          </div>

          <div class="space-y-2.5">
            {exclusiveBonus.map((bonus) => (
              <div class="flex gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center shrink-0">
                  <Icon name={bonus.icon} class="w-4 h-4 text-amber-600" />
                </div>
                <div>
                  <h4 class="text-xs font-semibold text-zinc-900">{bonus.title}</h4>
                  <p class="text-[11px] text-zinc-600">{bonus.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA -->
        <div class="bg-zinc-900 rounded-xl p-5 text-center">
          <p class="text-white text-sm font-medium mb-1">Prêt à automatiser ?</p>
          <p class="text-zinc-400 text-xs mb-4">{totalLessons}+ leçons · Accès à vie</p>
          <CTAButton href="#pricing" />
          <p class="text-xs text-zinc-500 mt-3">499€/an · Garantie 30 jours</p>
        </div>

      </div>
    </div>
  </div>
</section>
