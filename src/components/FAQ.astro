---
// FAQ section - Dark mode design
import GridBackground from './ui/GridBackground.astro';

const faqs = [
    {
        q: "C'est un paiement unique ?",
        a: "Oui, 499€ une seule fois. Accès à vie à tout le contenu, mises à jour et communauté inclus.",
    },
    {
        q: "Faut-il savoir coder ?",
        a: "Non, zéro code. Make est 100% no-code, tout se fait en glisser-déposer.",
    },
    {
        q: "Et si la formation ne me convient pas ?",
        a: "Garantie 30 jours : remboursement sans question, un simple email suffit.",
    },
    {
        q: "La formation est-elle éligible au CPF ?",
        a: "Oui ! <a href='https://lilian.yt/makecpf?ref=sitefaq' class='text-violet-400 hover:text-violet-300 underline font-medium'>Vérifie ton éligibilité ici</a> — je gère l'administratif.",
    },
    {
        q: "Une question ?",
        a: "Écris-moi sur LinkedIn ou à lilian@apprendremake.fr — je réponds personnellement.",
    },
];
---

<section class="relative py-16 md:py-20 bg-zinc-950 overflow-hidden">
    <GridBackground />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,#09090b_70%)]"></div>

    <div class="relative max-w-2xl mx-auto px-4 md:px-6">
        <!-- Header -->
        <div class="text-center mb-10">
            <p
                class="text-violet-400 text-xs font-medium tracking-wider uppercase mb-3"
            >
                Vos questions
            </p>
            <h2 class="text-xl md:text-2xl font-semibold text-white">
                Vous hésitez encore ?
            </h2>
        </div>

        <!-- FAQ Items -->
        <div class="space-y-2">
            {
                faqs.map((faq, i) => (
                    <details class="group faq-item rounded-lg overflow-hidden" open={i === 0}>
                        <summary class="flex items-center justify-between px-5 py-4 bg-zinc-900/80 border border-zinc-800 cursor-pointer list-none transition-all duration-200 hover:border-violet-500/30 group-open:bg-violet-500/10 group-open:border-violet-500/30">
                            <span class="text-base font-semibold text-zinc-300 pr-4 group-open:text-violet-300">
                                {faq.q}
                            </span>
                            <svg
                                class="w-4 h-4 text-zinc-500 shrink-0 transition-all duration-200 group-open:rotate-180 group-open:text-violet-400"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"
                                />
                            </svg>
                        </summary>
                        <div class="faq-content">
                            <div class="px-5 py-3 text-sm text-zinc-400 leading-relaxed bg-zinc-900/50 border-x border-b border-zinc-800" set:html={faq.a}>
                            </div>
                        </div>
                    </details>
                ))
            }
        </div>
    </div>
</section>

<style>
  /* Smooth animation for FAQ items */
  .faq-item .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s ease-out;
  }

  .faq-item[open] .faq-content {
    grid-template-rows: 1fr;
  }

  .faq-item .faq-content > div {
    overflow: hidden;
  }

  /* Remove default marker */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Empêche le scroll automatique quand on ouvre/ferme une question
  document.querySelectorAll('.faq-item summary').forEach(summary => {
    summary.addEventListener('click', (e) => {
      const details = summary.parentElement as HTMLDetailsElement;
      const scrollY = window.scrollY;

      // Après le toggle, restaurer la position de scroll
      requestAnimationFrame(() => {
        window.scrollTo(0, scrollY);
      });
    });
  });
</script>
