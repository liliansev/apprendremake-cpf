---
// FAQ section - Questions reconversion
import GridBackground from './ui/GridBackground.astro';
import CTAButton from './CTAButton.astro';

const faqs = [
    {
        q: "Je n'ai aucune expérience technique, c'est vraiment pour moi ?",
        a: "Oui, absolument. Make est 100% no-code — tout se fait en glisser-déposer. <strong>80% de mes élèves n'avaient aucun background technique</strong>. Si vous savez utiliser un ordinateur, vous pouvez apprendre Make.",
    },
    {
        q: "Quels métiers après cette formation ?",
        a: "Consultant Make freelance, Ops Manager, Responsable automatisation, Intégrateur no-code... Les entreprises s'arrachent ces profils. Le no-code est <strong>le secteur qui recrute le plus</strong> dans le digital.",
    },
    {
        q: "J'ai 40/45/50 ans, c'est trop tard ?",
        a: "Non. La moyenne d'âge de mes élèves est de <strong>38 ans</strong>. Votre expérience professionnelle est un atout, pas un frein. Vous comprenez les problèmes des entreprises — Make vous donne les outils pour les résoudre.",
    },
    {
        q: "Combien de temps pour trouver mes premiers clients ?",
        a: "Mes élèves les plus motivés décrochent leurs <strong>premiers clients en 2-3 mois</strong>. Certains pendant la formation. Tout dépend de votre investissement et de votre réseau.",
    },
    {
        q: "Comment financer cette formation avec mon CPF ?",
        a: "C'est simple : cliquez sur le bouton d'inscription, créez votre compte sur la plateforme CPF, et suivez les instructions. La formation est <strong>100% prise en charge</strong> — vous ne déboursez rien de votre poche.",
    },
    {
        q: "La formation est-elle certifiante ?",
        a: "Oui ! Cette formation est enregistrée au <strong>Répertoire Spécifique sous le code RS6228</strong>. Vous recevez une attestation de fin de formation reconnue que vous pouvez valoriser sur votre CV et LinkedIn.",
    },
];
---

<section class="relative py-16 md:py-20 bg-zinc-950 overflow-hidden">
    <GridBackground />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,#09090b_70%)]"></div>

    <div class="relative max-w-2xl mx-auto px-4 md:px-6">
        <!-- Header -->
        <div class="text-center mb-10">
            <p
                class="text-violet-400 text-xs font-medium tracking-wider uppercase mb-3"
            >
                Questions fréquentes
            </p>
            <h2 class="text-xl md:text-2xl font-semibold text-white">
                Vous hésitez encore ?
            </h2>
            <p class="text-zinc-400 text-sm mt-2">Les réponses aux questions les plus posées par les personnes en reconversion</p>
        </div>

        <!-- FAQ Items -->
        <div class="space-y-2">
            {
                faqs.map((faq, i) => (
                    <details class="group faq-item rounded-lg overflow-hidden" open={i === 0}>
                        <summary class="flex items-center justify-between px-5 py-4 bg-zinc-900/80 border border-zinc-800 cursor-pointer list-none transition-all duration-200 hover:border-violet-500/30 group-open:bg-violet-500/10 group-open:border-violet-500/30">
                            <span class="text-base font-semibold text-zinc-300 pr-4 group-open:text-violet-300">
                                {faq.q}
                            </span>
                            <svg
                                class="w-4 h-4 text-zinc-500 shrink-0 transition-all duration-200 group-open:rotate-180 group-open:text-violet-400"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"
                                />
                            </svg>
                        </summary>
                        <div class="faq-content">
                            <div class="px-5 py-3 text-sm text-zinc-400 leading-relaxed bg-zinc-900/50 border-x border-b border-zinc-800" set:html={faq.a}>
                            </div>
                        </div>
                    </details>
                ))
            }
        </div>

        <!-- Bottom CTA -->
        <div class="mt-10 text-center">
            <p class="text-zinc-400 text-sm mb-2">Une autre question ?</p>
            <p class="text-zinc-500 text-sm mb-6">
                Écrivez-moi sur <a href="https://linkedin.com/in/lilian" class="text-violet-400 hover:text-violet-300 underline">LinkedIn</a> ou à <a href="mailto:lilian@apprendremake.fr" class="text-violet-400 hover:text-violet-300 underline">lilian@apprendremake.fr</a>
            </p>
            <CTAButton href="#pricing" text="Financer ma formation" variant="cpf" />
        </div>
    </div>
</section>

<style>
  /* Smooth animation for FAQ items */
  .faq-item .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s ease-out;
  }

  .faq-item[open] .faq-content {
    grid-template-rows: 1fr;
  }

  .faq-item .faq-content > div {
    overflow: hidden;
  }

  /* Remove default marker */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Empêche le scroll automatique quand on ouvre/ferme une question
  document.querySelectorAll('.faq-item summary').forEach(summary => {
    summary.addEventListener('click', (e) => {
      const details = summary.parentElement as HTMLDetailsElement;
      const scrollY = window.scrollY;

      // Après le toggle, restaurer la position de scroll
      requestAnimationFrame(() => {
        window.scrollTo(0, scrollY);
      });
    });
  });
</script>
