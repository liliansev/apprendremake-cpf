---
// FAQ section - Dark mode design
import GridBackground from './ui/GridBackground.astro';

const faqs = [
    {
        q: "C'est un paiement unique ?",
        a: "Oui, c'est un paiement unique de 499€. Tu as accès à vie à tout : + de 100 vidéos, les nouveaux projets, les mises à jour, la communauté et le support.",
    },
    {
        q: "Faut-il savoir coder ?",
        a: "Non, zéro code requis. Make est un outil no-code, tout se fait en glisser-déposer. Si tu sais utiliser Excel, tu peux apprendre Make.",
    },
    {
        q: "Est-ce que 499€ ça vaut vraiment le coup ?",
        a: "Fais le calcul : si tu gagnes 10h/semaine grâce à l'automatisation, que votre temps vaut 50€/h c'est 500€ économisés dès la première semaine.",
    },
    {
        q: "Je n'ai pas le temps de suivre une formation...",
        a: "+ de 100 vidéos de 5-15 min, à ton rythme. Tu n'as pas le temps de récupérer enfin ton temps ?",
    },
    {
        q: "Je suis débutant, c'est pas trop technique ?",
        a: "Non. J'ai 0 background technique, je viens pas du monde du développement mais j'ai appris, et je t'enseignerai.",
    },
    {
        q: "Pourquoi payer alors qu'il y a des tutos gratuits sur YouTube ?",
        a: "Parce que YouTube c'est le chaos : pas de structure, des vidéos dispersées, et tu galères seul. Ici tu as un parcours complet, des projets réels, et le support direct de l'expert Make le plus certifié de France. Tu gagnes des mois d'apprentissage.",
    },
    {
        q: "Et si la formation ne me convient pas ?",
        a: "Garantie 30 jours : je te rembourse sans poser de questions. Pas de justification, pas de formulaire, un simple email suffit.",
    },
    {
        q: "La formation est-elle éligible au CPF ?",
        a: "Oui ! Une version certifiante est disponible pour le financement CPF. <a href='https://lilian.yt/makecpf?ref=sitefaq' class='text-violet-400 hover:text-violet-300 underline font-medium'>Vérifie ton éligibilité ici</a> — je gère tout l'administratif pour toi.",
    },
    {
        q: "Une question ? Besoin d'échanger ?",
        a: "Écris-moi directement sur LinkedIn ou par email à lilian@apprendremake.fr — je réponds personnellement à tous les messages.",
    },
];
---

<section class="relative py-16 md:py-20 bg-zinc-950 overflow-hidden">
    <GridBackground />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,#09090b_70%)]"></div>

    <div class="relative max-w-2xl mx-auto px-4 md:px-6">
        <!-- Header -->
        <div class="text-center mb-10">
            <p
                class="text-violet-400 text-xs font-medium tracking-wider uppercase mb-3"
            >
                Vos questions
            </p>
            <h2 class="text-xl md:text-2xl font-semibold text-white">
                Vous hésitez encore ?
            </h2>
        </div>

        <!-- FAQ Items -->
        <div class="space-y-2">
            {
                faqs.map((faq, i) => (
                    <details class="group faq-item rounded-lg overflow-hidden" open={i === 0}>
                        <summary class="flex items-center justify-between px-4 py-3 bg-zinc-900/80 border border-zinc-800 cursor-pointer list-none transition-all duration-200 hover:border-violet-500/30 group-open:bg-violet-500/10 group-open:border-violet-500/30">
                            <span class="text-xs font-medium text-zinc-300 pr-4 group-open:text-violet-300">
                                {faq.q}
                            </span>
                            <svg
                                class="w-3.5 h-3.5 text-zinc-500 shrink-0 transition-all duration-200 group-open:rotate-180 group-open:text-violet-400"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"
                                />
                            </svg>
                        </summary>
                        <div class="faq-content">
                            <div class="px-4 py-3 text-xs text-zinc-400 leading-relaxed bg-zinc-900/50 border-x border-b border-zinc-800" set:html={faq.a}>
                            </div>
                        </div>
                    </details>
                ))
            }
        </div>
    </div>
</section>

<style>
  /* Smooth animation for FAQ items */
  .faq-item .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s ease-out;
  }

  .faq-item[open] .faq-content {
    grid-template-rows: 1fr;
  }

  .faq-item .faq-content > div {
    overflow: hidden;
  }

  /* Remove default marker */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
