---
// CTA Final - Vente directeim
import CTAButton from "./CTAButton.astro";
import GridBackground from "./ui/GridBackground.astro";

const benefits = [
    "+ de 100 vidéos",
    "De zéro à autonome",
    "Nouveaux projets réguliers",
];

const reassurances = [
    "🔒 Paiement sécurisé",
    "Accès immédiat",
    "Garantie 30 jours",
];
---

<section
    id="cta-final"
    class="relative py-16 md:py-24 bg-zinc-950 overflow-hidden"
>
    <!-- Grille en fond (DOIT être à l'intérieur du conteneur relative) -->
    <GridBackground />

    <div class="relative max-w-5xl mx-auto px-4 md:px-6 text-center">
        <h2 class="text-2xl md:text-3xl font-semibold text-white mb-4">
            Arrêtez de perdre du temps.<br class="hidden sm:block" />
            <span class="text-violet-400">Automatisez.</span>
        </h2>

        <!-- Benefits -->
        <ul
            class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6 text-sm text-zinc-400 mb-6"
        >
            {
                benefits.map((benefit) => (
                    <li class="flex items-center gap-2">
                        <svg
                            class="w-4 h-4 text-violet-400 shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"
                            />
                        </svg>
                        {benefit}
                    </li>
                ))
            }
        </ul>

        <!-- Price -->
        <p class="text-zinc-400 text-sm mb-6">
            <span class="text-white font-semibold text-lg">499€</span> · Accès à vie
        </p>

        <!-- CTA -->
        <CTAButton href="#pricing" />

        <!-- Micro-reassurance -->
        <p class="text-xs text-zinc-500 mt-4">
            {reassurances.join(" · ")}
        </p>
    </div>
</section>
