---
// Footer - Minimal
const year = new Date().getFullYear();
---

<footer class="py-8 pb-[calc(2rem+env(safe-area-inset-bottom))] bg-zinc-900 border-t border-zinc-800">
  <div class="max-w-5xl mx-auto px-4 md:px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <!-- Logo -->
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded bg-white flex items-center justify-center">
          <span class="text-zinc-900 text-[10px] font-semibold">AM</span>
        </div>
        <span class="text-sm font-medium text-white">Apprendre Make</span>
      </div>

      <!-- Links -->
      <nav class="flex items-center gap-6 text-xs">
        <a href="#" class="text-zinc-400 hover:text-white transition-colors">Mentions légales</a>
        <a href="#" class="text-zinc-400 hover:text-white transition-colors">CGV</a>
        <a href="#" class="text-zinc-400 hover:text-white transition-colors">Contact</a>
      </nav>

      <!-- Copyright -->
      <p class="text-xs text-zinc-500">
        © {year} Apprendre Make
      </p>
    </div>
  </div>
</footer>
