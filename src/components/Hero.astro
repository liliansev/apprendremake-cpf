---
// Hero section - Full-screen dark design with animated grid
import CTAButton from "./CTAButton.astro";
import GridBackground from "./ui/GridBackground.astro";
import { Icon } from "astro-icon/components";

const features = [
    "+ de 100 vidéos",
    "Projets pratiques",
    "Exercices corrigés",
    "Support réactif",
];

// Apps with their simple-icons name
const apps = [
    { name: "Notion", icon: "simple-icons:notion" },
    { name: "Airtable", icon: "simple-icons:airtable" },
    { name: "Google Sheets", icon: "simple-icons:googlesheets" },
    { name: "Slack", icon: "simple-icons:slack" },
    { name: "Gmail", icon: "simple-icons:gmail" },
    { name: "HubSpot", icon: "simple-icons:hubspot" },
    { name: "Stripe", icon: "simple-icons:stripe" },
    { name: "Shopify", icon: "simple-icons:shopify" },
    { name: "Webflow", icon: "simple-icons:webflow" },
    { name: "Discord", icon: "simple-icons:discord" },
    { name: "Trello", icon: "simple-icons:trello" },
    { name: "Asana", icon: "simple-icons:asana" },
    { name: "Mailchimp", icon: "simple-icons:mailchimp" },
    { name: "Figma", icon: "simple-icons:figma" },
    { name: "Linear", icon: "simple-icons:linear" },
    { name: "Dropbox", icon: "simple-icons:dropbox" },
    { name: "OpenAI", icon: "simple-icons:openai" },
];
---

<section
    class="relative min-h-screen flex flex-col overflow-hidden bg-zinc-950"
>
    <!-- Grid pattern -->
    <GridBackground opacity={3} />

    <!-- Animated glow lines -->
    <div class="absolute inset-0">
        <div
            class="grid-line-h absolute left-0 right-0 h-px bg-gradient-to-r from-transparent via-violet-400/50 to-transparent"
            style="top: 20%;"
        >
        </div>
        <div
            class="grid-line-h absolute left-0 right-0 h-px bg-gradient-to-r from-transparent via-violet-500/35 to-transparent"
            style="top: 40%; animation-delay: 2s;"
        >
        </div>
        <div
            class="grid-line-h absolute left-0 right-0 h-px bg-gradient-to-r from-transparent via-violet-500/25 to-transparent"
            style="top: 60%; animation-delay: 4s;"
        >
        </div>
        <div
            class="grid-line-v absolute top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-violet-400/40 to-transparent"
            style="left: 15%;"
        >
        </div>
        <div
            class="grid-line-v absolute top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-violet-500/35 to-transparent"
            style="left: 85%; animation-delay: 2.5s;"
        >
        </div>
        <div
            class="grid-line-v absolute top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-violet-500/20 to-transparent"
            style="left: 50%; animation-delay: 1s;"
        >
        </div>
    </div>

    <!-- Gradient orbs -->
    <div
        class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-violet-600/15 rounded-full blur-3xl"
    >
    </div>
    <div
        class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-violet-500/10 rounded-full blur-3xl"
    >
    </div>

    <!-- Radial fade -->
    <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,#09090b_75%)]"
    >
    </div>

    <!-- Main content -->
    <div
        class="relative flex-1 flex flex-col justify-center pt-20 pb-8 md:pt-24 md:pb-12"
    >
        <div class="max-w-5xl mx-auto px-4 md:px-6 w-full">
            <div class="text-center">
                <!-- Badge - Expert certifié mis en avant -->
                <div class="inline-flex items-center gap-2 mb-6 md:mb-8">
                    <span
                        class="inline-flex items-center gap-1.5 text-amber-300 text-xs font-semibold px-4 py-2 rounded-full bg-amber-500/15 border border-amber-500/30"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"></path>
                        </svg>
                        🇫🇷 Expert Make le plus certifié de France
                    </span>
                </div>

                <!-- H1 - SEO: "reporting" visible pour les crawlers -->
                <h1
                    class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight text-white mb-4 md:mb-6 leading-[1.15]"
                >
                    <div>Récupérez <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-violet-300">10h par semaine.</span></div>
                    <!-- Ligne 2 : w-0 + overflow-visible = n'affecte pas le centrage -->
                    <div class="w-0 overflow-visible whitespace-nowrap">Automatisez votre <span
                            id="rotating-word"
                            class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-violet-300"
                            >CRM</span> <span class="text-zinc-400">avec Make.</span>
                    </div>
                </h1>

                <!-- H2 / Subheadline -->
                <p
                    class="text-base md:text-xl text-zinc-400 max-w-2xl mx-auto mb-6 md:mb-8 leading-relaxed"
                >
                    Apprenez à créer des scénarios intelligents et arrêtez enfin de faire le travail d'un robot.
                </p>

                <!-- Feature tags -->
                <div
                    class="flex flex-wrap items-center justify-center gap-2 mb-8 md:mb-10"
                >
                    {
                        features.map((feature) => (
                            <span class="inline-flex items-center gap-1.5 text-zinc-500 text-xs px-3 py-1.5 rounded-full bg-white/5 border border-white/5">
                                <svg
                                    class="w-3 h-3 text-violet-500"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                        clip-rule="evenodd"
                                    />
                                </svg>
                                {feature}
                            </span>
                        ))
                    }
                </div>

                <!-- CTAs -->
                <div
                    class="flex flex-col sm:flex-row items-center justify-center gap-3 md:gap-4 mb-8 md:mb-12"
                >
                    <CTAButton href="#pricing" id="hero-cta" animated={true} />
                    <CTAButton
                        href="#programme"
                        text="Voir le programme"
                        variant="outline"
                        icon="chevron"
                        iconPosition="left"
                    />
                </div>

                <!-- Social Proof -->
                <p class="text-zinc-500 text-sm">+ 300 élèves formés</p>
            </div>
        </div>
    </div>

    <!-- Full-width Apps Banner -->
    <div class="relative pb-8 md:pb-12">
        <!-- Separator line -->
        <div
            class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-zinc-800 to-transparent"
        >
        </div>

        <div class="pt-8 md:pt-10">
            <p
                class="text-center text-[10px] text-zinc-600 uppercase tracking-[0.2em] mb-6"
            >
                Connectez Make à + de 2000 applications
            </p>

            <!-- Scrolling logos -->
            <div class="relative overflow-hidden">
                <!-- Fade edges -->
                <div
                    class="absolute left-0 top-0 bottom-0 w-24 md:w-40 bg-gradient-to-r from-zinc-950 to-transparent z-10"
                >
                </div>
                <div
                    class="absolute right-0 top-0 bottom-0 w-24 md:w-40 bg-gradient-to-l from-zinc-950 to-transparent z-10"
                >
                </div>

                <!-- Scrolling container - gap uniforme pour boucle infinie -->
                <div class="flex items-center gap-8 md:gap-12 animate-scroll">
                    {
                        [...apps, ...apps].map((app) => (
                            <div class="flex items-center gap-2 shrink-0">
                                <div class="w-8 h-8 md:w-10 md:h-10 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-400">
                                    <Icon name={app.icon} class="w-4 h-4 md:w-5 md:h-5" />
                                </div>
                                <span class="text-xs md:text-sm font-medium text-zinc-500 whitespace-nowrap">
                                    {app.name}
                                </span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom luminous border -->
    <div class="absolute bottom-0 left-0 right-0">
        <div
            class="h-px bg-gradient-to-r from-transparent via-violet-500/60 to-transparent"
        >
        </div>
    </div>
</section>

<style>
    /* Grid lines animation */
    .grid-line-h {
        animation: pulse-h 4s ease-in-out infinite;
    }

    .grid-line-v {
        animation: pulse-v 5s ease-in-out infinite;
    }

    @keyframes pulse-h {
        0%,
        100% {
            opacity: 0;
            transform: scaleX(0.2);
        }
        50% {
            opacity: 1;
            transform: scaleX(1);
        }
    }

    @keyframes pulse-v {
        0%,
        100% {
            opacity: 0;
            transform: scaleY(0.2);
        }
        50% {
            opacity: 1;
            transform: scaleY(1);
        }
    }

    /* Scroll animation for logos */
    @keyframes scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    .animate-scroll {
        animation: scroll 40s linear infinite;
    }

    .animate-scroll:hover {
        animation-play-state: paused;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const rotatingWord = document.getElementById("rotating-word");
        const words = [
            "CRM",
            "reporting",
            "Notion",
            "facturation",
            "prospection",
            "onboarding",
            "Airtable",
        ];
        let wordIndex = 0;

        if (!rotatingWord) return;

        // Démarre l'animation après un court délai
        setTimeout(() => {
            setInterval(() => {
                // Le mot actuel sort vers le bas
                rotatingWord.style.transition = "opacity 0.15s ease-in, transform 0.15s ease-in";
                rotatingWord.style.opacity = "0";
                rotatingWord.style.transform = "translateY(100%)";

                setTimeout(() => {
                    // Le nouveau mot arrive du haut
                    rotatingWord.style.transition = "none";
                    rotatingWord.style.transform = "translateY(-50%)";
                    wordIndex = (wordIndex + 1) % words.length;
                    rotatingWord.textContent = words[wordIndex];

                    // Force reflow puis anime
                    rotatingWord.offsetHeight;
                    rotatingWord.style.transition = "opacity 0.2s ease-out, transform 0.2s ease-out";
                    rotatingWord.style.opacity = "1";
                    rotatingWord.style.transform = "translateY(0)";
                }, 150);
            }, 2500);
        }, 2000);
    });
</script>
