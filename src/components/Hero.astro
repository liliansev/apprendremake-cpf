---
// Hero section - Modern minimal design
---

<section class="relative pt-16 pb-24 md:pt-24 md:pb-32 overflow-hidden">
  <!-- Subtle gradient background -->
  <div class="absolute inset-0 bg-gradient-to-b from-violet-50/30 to-white"></div>

  <!-- Grid pattern -->
  <div class="absolute inset-0 opacity-[0.015]" style="background-image: linear-gradient(to right, #7c3aed 1px, transparent 1px), linear-gradient(to bottom, #7c3aed 1px, transparent 1px); background-size: 40px 40px;"></div>

  <div class="relative max-w-5xl mx-auto px-4 md:px-6">
    <div class="text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 mb-6">
        <span class="inline-flex items-center gap-1.5 text-violet-600 text-xs font-medium px-3 py-1.5 rounded-full bg-violet-50 border border-violet-100">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          Certifié Make Partner
        </span>
        <span class="inline-flex items-center gap-1.5 text-zinc-600 text-xs font-medium px-3 py-1.5 rounded-full bg-zinc-100 border border-zinc-200">
          + de 90 leçons
        </span>
      </div>

      <!-- Headline -->
      <h1 class="text-[1.625rem] sm:text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight text-zinc-900 mb-5 leading-[1.15]">
        Automatisez <span class="text-violet-600">80%</span> de vos tâches<br class="hidden sm:block" />
        <span class="text-zinc-400">en 5 semaines</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-base md:text-lg text-zinc-500 max-w-xl mx-auto mb-8 leading-relaxed">
        De zéro à autonome sur Make. 106 leçons pratiques, des vrais projets terrain, et un formateur qui utilise Make au quotidien pour ses clients.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-10">
        <a
          href="#pricing"
          class="group w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-violet-600 hover:bg-violet-700 text-white text-sm font-medium px-6 py-3.5 rounded-lg transition-all"
        >
          <span>Je rejoins la formation — 499€</span>
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a
          href="#programme"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-zinc-600 hover:text-zinc-900 text-sm font-medium px-6 py-3 transition-colors"
        >
          <span>Voir le programme complet</span>
        </a>
      </div>

      <!-- Social Proof -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 text-sm">
        <div class="flex items-center gap-2">
          <div class="flex -space-x-2">
            <div class="w-7 h-7 rounded-full bg-violet-200 border-2 border-white"></div>
            <div class="w-7 h-7 rounded-full bg-blue-200 border-2 border-white"></div>
            <div class="w-7 h-7 rounded-full bg-emerald-200 border-2 border-white"></div>
            <div class="w-7 h-7 rounded-full bg-amber-200 border-2 border-white"></div>
          </div>
          <div class="flex items-center gap-1.5 text-zinc-500">
            <div class="flex">
              {[1, 2, 3, 4, 5].map(() => (
                <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                </svg>
              ))}
            </div>
            <span class="text-zinc-600 font-medium">300+ apprenants</span>
          </div>
        </div>
        <span class="hidden sm:block text-zinc-300">•</span>
        <span class="text-zinc-500">Formateur de Qonto, Alan, Vercel</span>
      </div>
    </div>
  </div>
</section>
