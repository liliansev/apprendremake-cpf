---
// Hero section - Light mode design for reconversion target
import CTAButton from "./CTAButton.astro";
import LightGridBackground from "./ui/LightGridBackground.astro";
import ScrollingLogos from "./ui/ScrollingLogos.astro";

const features = [
    "Aucun prérequis technique",
    "Formation certifiante RS6228",
    "100% financé par le CPF",
    "Accompagnement personnalisé",
];

// Words for animation
const animatedWords = [
    "facturation",
    "emails",
    "CRM",
    "reporting",
    "onboarding",
    "support client",
];

// Apps with their simple-icons name
const apps = [
    { name: "Notion", icon: "simple-icons:notion" },
    { name: "Airtable", icon: "simple-icons:airtable" },
    { name: "Google Sheets", icon: "simple-icons:googlesheets" },
    { name: "Slack", icon: "simple-icons:slack" },
    { name: "Gmail", icon: "simple-icons:gmail" },
    { name: "HubSpot", icon: "simple-icons:hubspot" },
    { name: "Stripe", icon: "simple-icons:stripe" },
    { name: "Shopify", icon: "simple-icons:shopify" },
    { name: "Webflow", icon: "simple-icons:webflow" },
    { name: "Discord", icon: "simple-icons:discord" },
    { name: "Trello", icon: "simple-icons:trello" },
    { name: "Asana", icon: "simple-icons:asana" },
    { name: "Mailchimp", icon: "simple-icons:mailchimp" },
    { name: "Figma", icon: "simple-icons:figma" },
    { name: "Linear", icon: "simple-icons:linear" },
    { name: "Dropbox", icon: "simple-icons:dropbox" },
    { name: "OpenAI", icon: "simple-icons:openai" },
];
---

<section
    class="relative min-h-screen flex flex-col overflow-hidden bg-white"
>
    <!-- Light grid pattern -->
    <LightGridBackground opacity={5} />

    <!-- Gradient orbs - subtle on light -->
    <div
        class="absolute top-1/4 left-1/4 w-[600px] h-[600px] bg-violet-200/30 rounded-full blur-3xl"
    >
    </div>
    <div
        class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-emerald-200/20 rounded-full blur-3xl"
    >
    </div>

    <!-- Main content -->
    <div
        class="relative flex-1 flex flex-col justify-center pt-24 pb-8 md:pt-28 md:pb-12"
    >
        <div class="max-w-5xl mx-auto px-4 md:px-6 w-full">
            <div class="text-center">
                <!-- Badges CPF + Urgence -->
                <div class="inline-flex flex-wrap items-center justify-center gap-2 mb-6 md:mb-8">
                    <span
                        class="inline-flex items-center gap-1.5 text-emerald-700 text-xs font-semibold px-4 py-2 rounded-full bg-emerald-100 border border-emerald-200"
                    >
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                        </svg>
                        Formation certifiante · 100% financé CPF
                    </span>
                    <span
                        class="inline-flex items-center gap-1.5 text-amber-700 text-xs font-semibold px-4 py-2 rounded-full bg-amber-50 border border-amber-200 animate-pulse"
                    >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Places limitées — Session mars 2026
                    </span>
                </div>

                <!-- H1 -->
                <h1
                    class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight text-zinc-900 mb-4 md:mb-6 leading-[1.15]"
                >
                    <div>Le métier tech qui recrute</div>
                    <div class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-violet-500">sans savoir coder</div>
                    <div class="text-zinc-500 text-xl sm:text-2xl md:text-3xl lg:text-4xl mt-3">
                        Automatisez <span id="animated-word" class="text-violet-600 font-semibold">facturation</span> et gagnez en autonomie
                    </div>
                </h1>

                <!-- H2 / Subheadline -->
                <p
                    class="text-base md:text-xl text-zinc-600 max-w-2xl mx-auto mb-6 md:mb-8 leading-relaxed"
                >
                    Formation certifiante RS6228, accessible aux débutants complets. <span class="font-semibold text-emerald-600">100% financée par votre CPF</span> — vous ne payez rien.
                </p>

                <!-- Feature tags -->
                <div
                    class="flex flex-wrap items-center justify-center gap-2 mb-8 md:mb-10"
                >
                    {
                        features.map((feature) => (
                            <span class="inline-flex items-center gap-1.5 text-zinc-600 text-xs px-3 py-1.5 rounded-full bg-zinc-100 border border-zinc-200">
                                <svg
                                    class="w-3 h-3 text-violet-500"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                        clip-rule="evenodd"
                                    />
                                </svg>
                                {feature}
                            </span>
                        ))
                    }
                </div>

                <!-- CTAs -->
                <div
                    class="flex flex-col sm:flex-row items-center justify-center gap-3 md:gap-4 mb-8 md:mb-12"
                >
                    <CTAButton href="#pricing" text="Financer avec mon CPF" variant="cpf" id="hero-cta" animated={true} />
                    <CTAButton
                        href="#programme"
                        text="Découvrir le programme"
                        variant="outline"
                        icon="chevron"
                        iconPosition="left"
                    />
                </div>

                <!-- Social Proof - Stats bar -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl mx-auto">
                    <div class="text-center p-3 rounded-xl bg-zinc-50 border border-zinc-100">
                        <div class="text-lg font-bold text-zinc-900">300+</div>
                        <div class="text-xs text-zinc-500">personnes formées</div>
                    </div>
                    <div class="text-center p-3 rounded-xl bg-zinc-50 border border-zinc-100">
                        <div class="text-lg font-bold text-emerald-600">92%</div>
                        <div class="text-xs text-zinc-500">taux de satisfaction</div>
                    </div>
                    <div class="text-center p-3 rounded-xl bg-zinc-50 border border-zinc-100">
                        <div class="text-lg font-bold text-zinc-900">2-3 mois</div>
                        <div class="text-xs text-zinc-500">premiers clients</div>
                    </div>
                    <div class="text-center p-3 rounded-xl bg-emerald-50 border border-emerald-100">
                        <div class="text-lg font-bold text-emerald-600">0€</div>
                        <div class="text-xs text-emerald-600">grâce au CPF</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Full-width Apps Banner -->
    <div class="relative pb-8 md:pb-12 bg-gradient-to-b from-white to-neutral-50">
        <!-- Separator line -->
        <div
            class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-zinc-200 to-transparent"
        >
        </div>

        <div class="pt-8 md:pt-10">
            <ScrollingLogos
                items={apps}
                title="Automatisez + de 2000 applications sans coder"
                variant="light"
            />
        </div>
    </div>

    <!-- Bottom border -->
    <div class="absolute bottom-0 left-0 right-0">
        <div
            class="h-px bg-gradient-to-r from-transparent via-violet-300/50 to-transparent"
        >
        </div>
    </div>
</section>

<script define:vars={{ animatedWords }}>
  // Word animation
  const wordElement = document.getElementById('animated-word');
  if (wordElement) {
    let currentIndex = 0;
    setInterval(() => {
      currentIndex = (currentIndex + 1) % animatedWords.length;
      wordElement.style.opacity = '0';
      wordElement.style.transform = 'translateY(-10px)';
      setTimeout(() => {
        wordElement.textContent = animatedWords[currentIndex];
        wordElement.style.opacity = '1';
        wordElement.style.transform = 'translateY(0)';
      }, 200);
    }, 2500);
  }
</script>

<style>
  #animated-word {
    display: inline-block;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
</style>
