---
// Cible section - Profils reconversion (LIGHT)
import { Icon } from 'astro-icon/components';
import LightGridBackground from "./ui/LightGridBackground.astro";

const targets = [
  {
    icon: "lucide:heart-crack",
    iconBg: "from-violet-500 to-violet-600",
    title: "Vous en avez marre de votre job",
    benefit: "Nouvelle carrière",
    description: "Vous avez fait le tour. Le salaire ne compense plus l'ennui. Vous rêvez de vous lever motivé le lundi matin."
  },
  {
    icon: "lucide:search",
    iconBg: "from-emerald-500 to-emerald-600",
    title: "Vous cherchez un emploi porteur",
    benefit: "Forte demande",
    description: "Les offres classiques ne vous font plus rêver. Vous voulez une compétence rare et recherchée."
  },
  {
    icon: "lucide:laptop",
    iconBg: "from-blue-500 to-blue-600",
    title: "Vous voulez entrer dans la tech",
    benefit: "Sans coder",
    description: "Le code vous fait peur mais le digital vous attire. Make est la porte d'entrée parfaite : 100% visuel."
  }
];
---

<section class="relative py-16 md:py-20 bg-white overflow-hidden">
  <!-- Background effects -->
  <LightGridBackground opacity={5} />
  <div class="absolute top-1/3 left-1/4 w-80 h-80 bg-violet-100/50 rounded-full blur-3xl"></div>

  <div class="relative max-w-6xl mx-auto px-4 md:px-6">
    <!-- Header -->
    <div class="text-center mb-12">
      <p class="text-violet-600 text-xs font-medium tracking-wider uppercase mb-3">Pour qui ?</p>
      <h2 class="text-2xl md:text-4xl font-semibold text-zinc-900 mb-4">
        Cette formation est faite pour vous si...
      </h2>
      <p class="text-zinc-500 max-w-xl mx-auto">
        Peu importe votre parcours, Make s'adapte à vos ambitions.
      </p>
    </div>

    <!-- Targets Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {targets.map((target) => (
        <div class="group p-6 rounded-2xl bg-neutral-50 border border-zinc-100 hover:border-violet-200 hover:bg-violet-50/30 hover:-translate-y-1 transition-all duration-200">
          <!-- Icon -->
          <div class="mb-5">
            <div class={`w-14 h-14 rounded-xl bg-gradient-to-br ${target.iconBg} flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-200`}>
              <Icon name={target.icon} class="w-7 h-7 text-white" />
            </div>
          </div>

          <!-- Benefit badge -->
          <span class="inline-flex items-center text-xs font-medium text-violet-700 bg-violet-100 px-2.5 py-1 rounded-full mb-3">
            {target.benefit}
          </span>

          <!-- Title -->
          <h3 class="text-lg font-semibold text-zinc-900 mb-2">{target.title}</h3>

          <!-- Description -->
          <p class="text-sm text-zinc-500 leading-relaxed">{target.description}</p>
        </div>
      ))}
    </div>

    <!-- Bottom reassurance -->
    <div class="mt-12 text-center">
      <p class="text-zinc-600">
        <span class="font-semibold text-zinc-900">Aucun prérequis technique.</span> Si vous savez utiliser un ordinateur, vous pouvez apprendre Make.
      </p>
    </div>
  </div>
</section>
