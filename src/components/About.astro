---
// About section - Timeline story with reconversion angle
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import LightGridBackground from './ui/LightGridBackground.astro';
import CTAButton from './CTAButton.astro';
import lilianImage from '../assets/lilian.jpg';

const timeline = [
  {
    year: "2021",
    title: "Premiers pas sur Integromat",
    subtitle: "Autodidacte",
    description: "Je découvre Integromat (l'ancêtre de Make) sans aucune formation. J'apprends seul, je galère, je persévère.",
    highlight: "Aucune ressource en français à l'époque."
  },
  {
    year: "2022",
    title: "Make Partner & Trainer",
    subtitle: "Reconnu par Make",
    description: "Integromat devient Make. Je deviens le 1er Français certifié Make Partner & Trainer.",
    highlight: "La reconnaissance officielle de mon expertise."
  },
  {
    year: "2023",
    title: "150+ projets livrés",
    subtitle: "Expertise terrain",
    description: "Je crée mon studio et j'automatise des dizaines d'entreprises. Des erreurs, des réussites, des apprentissages.",
    highlight: "Des centaines d'heures de pratique condensées."
  },
  {
    year: "2024",
    title: "Certification RS6228",
    subtitle: "Formation CPF",
    description: "Je structure tout ce que j'ai appris dans une formation certifiante éligible CPF.",
    highlight: "Pour que vous n'ayez pas à galérer comme moi."
  },
  {
    year: "2025",
    title: "300+ personnes formées",
    subtitle: "Reconversions réussies",
    description: "Des salariés, des demandeurs d'emploi, des reconversions... Tous ont trouvé leur voie grâce à Make.",
    highlight: "La prochaine success story, c'est la vôtre."
  },
  {
    year: "→",
    title: "Votre tour",
    subtitle: "Votre reconversion",
    description: "Cette timeline ne s'arrête pas là. La prochaine ligne, c'est vous qui l'écrivez.",
    highlight: "Je serai là pour vous accompagner.",
    isYou: true
  }
];
---

<section class="relative py-16 md:py-24 bg-neutral-50 overflow-hidden">
  <LightGridBackground opacity={5} />
  <div class="relative max-w-5xl mx-auto px-4 md:px-6">
    <!-- Header avec photo -->
    <div class="grid lg:grid-cols-3 gap-8 lg:gap-12 mb-12 md:mb-16">
      <!-- Photo + Badges -->
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-24">
          <div class="aspect-[4/5] max-w-[220px] mx-auto lg:mx-0 rounded-2xl overflow-hidden mb-4 shadow-xl shadow-zinc-900/10">
            <Image
              src={lilianImage}
              alt="Lilian, formateur Make certifié Partner & Trainer, expert en automatisation no-code"
              class="w-full h-full object-cover object-top"
              width={440}
              height={550}
              quality={85}
              loading="lazy"
            />
          </div>
          <!-- Certifications -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-1.5 max-w-[220px] mx-auto lg:mx-0">
            <span class="inline-flex items-center gap-1 text-violet-600 text-[10px] font-semibold px-2 py-1 rounded-full bg-violet-100 border border-violet-200">
              <Icon name="lucide:badge-check" class="w-3 h-3" />
              Partner
            </span>
            <span class="inline-flex items-center gap-1 text-violet-600 text-[10px] font-semibold px-2 py-1 rounded-full bg-violet-100 border border-violet-200">
              <Icon name="lucide:badge-check" class="w-3 h-3" />
              Trainer
            </span>
            <span class="inline-flex items-center gap-1 text-violet-600 text-[10px] font-semibold px-2 py-1 rounded-full bg-violet-100 border border-violet-200">
              <Icon name="lucide:badge-check" class="w-3 h-3" />
              Certif. 4&5
            </span>
          </div>
        </div>
      </div>

      <!-- Titre + Quote + Timeline -->
      <div class="lg:col-span-2">
        <p class="text-violet-600 text-xs font-medium tracking-wider uppercase mb-3">Votre formateur</p>
        <h2 class="text-2xl md:text-3xl font-semibold text-zinc-900 mb-4">
          J'ai galéré pendant 4 ans<br class="hidden sm:block" />
          <span class="text-zinc-400">pour que vous n'ayez pas à le faire.</span>
        </h2>

        <!-- Quote simple -->
        <blockquote class="border-l-4 border-violet-500 pl-4 py-2 mb-8">
          <p class="text-zinc-600 italic">
            « La reconversion fait peur. Mon rôle, c'est de vous montrer que c'est possible — et de vous accompagner jusqu'au bout. »
          </p>
        </blockquote>

        <!-- Timeline simple -->
        <div class="relative">
          <!-- Ligne verticale -->
          <div class="absolute left-[23px] top-2 bottom-2 w-0.5 bg-gradient-to-b from-violet-500 via-violet-400 to-emerald-400 hidden md:block"></div>

          <div class="space-y-4 md:space-y-6">
            {timeline.map((item) => (
              <div class={`group relative flex gap-4 md:gap-6 p-3 -mx-3 rounded-xl transition-all duration-200 cursor-default ${item.isYou ? 'bg-emerald-50 hover:bg-emerald-100/80' : 'hover:bg-white/60 hover:shadow-sm'}`}>
                <!-- Year badge -->
                <div class={`shrink-0 w-11 h-11 md:w-12 md:h-12 rounded-xl flex items-center justify-center font-bold text-xs md:text-sm z-10 transition-transform duration-200 group-hover:scale-105 ${item.isYou ? 'bg-emerald-500 text-white' : 'bg-violet-600 text-white'}`}>
                  {item.year}
                </div>

                <!-- Content -->
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 mb-1">
                    <h3 class={`text-base md:text-lg font-bold ${item.isYou ? 'text-emerald-700' : 'text-zinc-900'}`}>{item.title}</h3>
                    <span class={`text-xs font-medium ${item.isYou ? 'text-emerald-600' : 'text-violet-600'}`}>— {item.subtitle}</span>
                  </div>
                  <p class={`text-sm leading-relaxed mb-1.5 ${item.isYou ? 'text-emerald-600/70' : 'text-zinc-500'}`}>
                    {item.description}
                  </p>
                  <p class={`text-sm font-semibold ${item.isYou ? 'text-emerald-700' : 'text-zinc-700'}`}>
                    {item.highlight}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Conclusion -->
    <div class="bg-gradient-to-br from-violet-600 to-violet-700 rounded-2xl p-6 md:p-8 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>
      </div>

      <div class="relative text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/20 mb-4">
          <Icon name="lucide:users" class="w-6 h-6 text-white" />
        </div>
        <h3 class="text-lg md:text-xl font-semibold text-white mb-3">
          Je vous accompagne de A à Z
        </h3>
        <p class="text-violet-100 max-w-2xl mx-auto mb-4">
          Vous n'êtes pas seul. Questions techniques, doutes, blocages...<br class="hidden sm:block" />
          Je suis là pour vous <span class="text-white font-medium">guider jusqu'à votre reconversion réussie</span>.
        </p>
        <p class="text-sm text-violet-200 max-w-xl mx-auto mb-6">
          80% de mes élèves n'avaient <span class="text-white font-medium">aucun background technique</span>. Aujourd'hui, ils maîtrisent Make.
        </p>
        <CTAButton href="#pricing" text="Rejoindre la formation" variant="light" />
      </div>
    </div>
  </div>
</section>
