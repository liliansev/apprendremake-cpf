---
// StatPill - Badge réutilisable avec icône pleine
// Utilisé dans Hero, Programme, etc.

interface Props {
  icon: "book" | "play" | "check" | "users" | "clock" | "star";
  text: string;
  variant?: "light" | "dark";
  class?: string;
}

const { icon, text, variant = "light", class: className = "" } = Astro.props;

const icons = {
  book: `<path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>`,
  play: `<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>`,
  check: `<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>`,
  users: `<path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>`,
  clock: `<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>`,
  star: `<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>`
};

const variantClasses = {
  light: "text-zinc-600 bg-white border border-zinc-200",
  dark: "text-zinc-400 bg-white/5 border border-white/10"
};

const iconColorClasses = {
  light: "text-violet-500",
  dark: "text-violet-400"
};
---

<span class:list={[
  "inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full",
  variantClasses[variant],
  className
]}>
  <svg
    class:list={["w-3.5 h-3.5", iconColorClasses[variant]]}
    fill="currentColor"
    viewBox="0 0 20 20"
  >
    <Fragment set:html={icons[icon]} />
  </svg>
  {text}
</span>
