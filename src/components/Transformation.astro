---
// Transformation section - "The Gap" - Before/After emotional journey (DARK)
import { Icon } from 'astro-icon/components';
import GridBackground from "./ui/GridBackground.astro";

const transformations = [
  {
    before: {
      icon: "lucide:bug",
      title: "L'enfer du débuggage",
      description: "Un scénario qui plante, une erreur 400 incompréhensible... et personne pour t'aider."
    },
    after: {
      icon: "lucide:zap",
      title: "Le réflexe chirurgical",
      description: "Tu résous n'importe quelle erreur en 2 minutes. Tes automatisations tournent à 100%."
    }
  },
  {
    before: {
      icon: "lucide:wallet",
      title: "La taxe \"Expert\"",
      description: "Payer un consultant 100€/h dès que tu veux ajouter une étape complexe à ton système."
    },
    after: {
      icon: "lucide:crown",
      title: "L'autonomie totale",
      description: "0€ dépensé en consultants. Tu es le seul maître à bord de tes systèmes les plus complexes."
    }
  },
  {
    before: {
      icon: "lucide:alert-triangle",
      title: "La boule au ventre",
      description: "Cette peur de \"tout casser\" dès que tu touches à un scénario en production."
    },
    after: {
      icon: "lucide:shield-check",
      title: "La sérénité du scale",
      description: "Tes systèmes tiennent la charge. Tu multiplies tes clients sans stress."
    }
  },
  {
    before: {
      icon: "lucide:clock",
      title: "Le temps qui file",
      description: "Des heures perdues chaque semaine sur des tâches répétitives que tu pourrais automatiser."
    },
    after: {
      icon: "lucide:rocket",
      title: "La machine à résultats",
      description: "Tes processus tournent en pilote automatique. Ton business grandit pendant que tu dors."
    }
  }
];
---

<section class="relative py-16 md:py-24 bg-zinc-950 overflow-hidden">
  <!-- Background effects -->
  <GridBackground />
  <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-violet-600/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-1/4 left-1/4 w-72 h-72 bg-red-500/5 rounded-full blur-3xl"></div>

  <div class="relative max-w-6xl mx-auto px-4 md:px-6">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16">
      <p class="text-violet-400 text-xs font-medium tracking-wider uppercase mb-3">La transformation</p>
      <h2 class="text-2xl md:text-4xl font-semibold text-white mb-4">
        Arrêtez de subir Make.<br class="hidden sm:block" />
        <span class="text-violet-400">Commencez à dompter l'outil.</span>
      </h2>
      <p class="text-zinc-400 max-w-xl mx-auto">
        Ce n'est pas juste une formation. C'est un changement d'état d'esprit.
      </p>
    </div>

    <!-- Desktop: Split screen -->
    <div class="hidden md:grid md:grid-cols-2 gap-0 rounded-2xl overflow-hidden border border-zinc-800 bg-zinc-900/50 backdrop-blur-sm">
      <!-- Before column -->
      <div class="p-8 lg:p-10 border-r border-zinc-800">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-full bg-red-500/20 flex items-center justify-center">
            <Icon name="lucide:x" class="w-5 h-5 text-red-400" />
          </div>
          <div>
            <p class="text-xs font-medium text-red-400 uppercase tracking-wider">Avant</p>
            <p class="text-lg font-semibold text-white">Seul face à la machine</p>
          </div>
        </div>

        <div class="space-y-6">
          {transformations.map((item) => (
            <div class="group">
              <div class="flex items-start gap-3">
                <div class="w-7 h-7 rounded-lg bg-red-500/20 flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name={item.before.icon} class="w-4 h-4 text-red-400" />
                </div>
                <div>
                  <h4 class="text-base font-semibold text-white mb-1">{item.before.title}</h4>
                  <p class="text-sm text-zinc-400 leading-relaxed">{item.before.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- After column -->
      <div class="p-8 lg:p-10 bg-violet-500/5">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-full bg-violet-500/20 flex items-center justify-center">
            <Icon name="lucide:check" class="w-5 h-5 text-violet-400" />
          </div>
          <div>
            <p class="text-xs font-medium text-violet-400 uppercase tracking-wider">Après</p>
            <p class="text-lg font-semibold text-white">Le mindset d'Expert</p>
          </div>
        </div>

        <div class="space-y-6">
          {transformations.map((item) => (
            <div class="group">
              <div class="flex items-start gap-3">
                <div class="w-7 h-7 rounded-lg bg-violet-500/20 flex items-center justify-center shrink-0 mt-0.5">
                  <Icon name={item.after.icon} class="w-4 h-4 text-violet-400" />
                </div>
                <div>
                  <h4 class="text-base font-semibold text-white mb-1">{item.after.title}</h4>
                  <p class="text-sm text-zinc-400 leading-relaxed">{item.after.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Mobile: Stacked cards (3 items only) -->
    <div class="md:hidden space-y-4">
      {transformations.slice(0, 3).map((item) => (
        <div class="rounded-xl overflow-hidden border border-zinc-800 bg-zinc-900/80">
          <!-- Before -->
          <div class="p-4 border-b border-zinc-800">
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-red-500/20 flex items-center justify-center shrink-0 mt-0.5">
                <Icon name={item.before.icon} class="w-4 h-4 text-red-400" />
              </div>
              <div>
                <p class="text-[10px] font-medium text-red-400 uppercase tracking-wider mb-0.5">Avant</p>
                <h4 class="text-sm font-semibold text-white mb-1">{item.before.title}</h4>
                <p class="text-xs text-zinc-400 leading-relaxed">{item.before.description}</p>
              </div>
            </div>
          </div>
          <!-- Arrow -->
          <div class="py-1.5 flex justify-center bg-zinc-800/50">
            <Icon name="lucide:arrow-down" class="w-4 h-4 text-violet-400" />
          </div>
          <!-- After -->
          <div class="p-4 bg-violet-500/5">
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-violet-500/20 flex items-center justify-center shrink-0 mt-0.5">
                <Icon name={item.after.icon} class="w-4 h-4 text-violet-400" />
              </div>
              <div>
                <p class="text-[10px] font-medium text-violet-400 uppercase tracking-wider mb-0.5">Après</p>
                <h4 class="text-sm font-semibold text-white mb-1">{item.after.title}</h4>
                <p class="text-xs text-zinc-400 leading-relaxed">{item.after.description}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom hook -->
    <div class="mt-10 text-center">
      <p class="text-lg text-zinc-400">
        <span class="font-semibold text-white">Devenez l'architecte de votre automatisation.</span> Votre business devient <span class="text-violet-400 font-medium">une machine autonome</span>.
      </p>
    </div>
  </div>
</section>
