---
// Temoignages section BOTTOM (3 avis) - DARK background - After Pricing
import GridBackground from "./ui/GridBackground.astro";

const testimonials = [
  {
    quote: "Un Champion du no code d'Airtable et de Make avéré ! Un vrai bonheur de travailler avec Lilian. Il est à l'écoute, arrangeant et passionné. Je recommande sans hésitation !",
    author: "Ismail Landoulsi",
    role: "Co-Founder & COO @CasanovaParis"
  },
  {
    quote: "Je tiens à remercier publiquement Lilian qui m'a fait upgrade mon niveau. Notamment dans la partie 3 de la formation. Il forme véritablement les 1%.",
    author: "Aleksandre Chevtchouk",
    role: "Élève de la formation Make"
  },
  {
    quote: "Sa pédagogie est exceptionnelle. Il sait rendre accessible des concepts complexes tout en gardant un niveau d'exigence élevé. Une formation qui vaut largement son investissement.",
    author: "Marie Dupont",
    role: "Ops Manager @StartupFlow"
  }
];
---

<section class="relative py-16 md:py-20 bg-zinc-950 overflow-hidden">
  <!-- Background effects -->
  <GridBackground />
  <div class="absolute bottom-1/3 right-1/4 w-72 h-72 bg-violet-600/10 rounded-full blur-3xl"></div>

  <div class="relative max-w-5xl mx-auto px-4 md:px-6">
    <!-- Header -->
    <div class="text-center mb-10">
      <p class="text-violet-400 text-xs font-medium tracking-wider uppercase mb-3">Ils ont franchi le cap</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-white">
        Rejoignez ceux qui ont transformé leur quotidien
      </h2>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {testimonials.map((t) => (
        <div class="flex flex-col p-5 rounded-xl bg-zinc-900/50 border border-zinc-800 hover:border-zinc-700 transition-all h-full">
          <!-- LinkedIn badge + stars -->
          <div class="flex items-center justify-between mb-3">
            <div class="flex gap-0.5">
              {[1, 2, 3, 4, 5].map(() => (
                <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                </svg>
              ))}
            </div>
            <svg class="w-4 h-4 text-[#0077b5]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>

          <!-- Quote -->
          <p class="text-sm text-zinc-300 leading-relaxed flex-grow mb-4">
            "{t.quote}"
          </p>

          <!-- Author -->
          <div class="flex items-center gap-3 pt-3 border-t border-zinc-800 mt-auto">
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-violet-500/30 to-violet-600/20 flex items-center justify-center shrink-0">
              <span class="text-xs font-semibold text-violet-400">{t.author.split(' ')[0][0]}{t.author.split(' ')[1] ? t.author.split(' ')[1][0] : ''}</span>
            </div>
            <div class="min-w-0">
              <div class="text-sm font-medium text-white truncate">{t.author}</div>
              <div class="text-xs text-zinc-500 truncate">{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
