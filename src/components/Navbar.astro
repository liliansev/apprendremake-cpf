---
// Navbar - Sticky with dynamic CTA and hide on pricing
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="absolute inset-0 bg-white/95 backdrop-blur-md border-b border-zinc-200/50 shadow-sm"></div>

  <div class="relative max-w-5xl mx-auto px-4 md:px-6">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-violet-500 to-violet-600 flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <span class="text-zinc-900 font-semibold text-sm tracking-tight">Apprendre Make</span>
      </a>

      <!-- CPF Badge + CTA - Hidden by default, appears when hero CTA scrolls out -->
      <div id="navbar-cta" class="navbar-cta-hidden flex items-center gap-3">
        <!-- CPF Badge -->
        <span class="hidden sm:inline-flex items-center gap-1 text-xs font-medium text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          100% CPF
        </span>

        <!-- CTA Button -->
        <a
          href="#pricing"
          class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium px-4 py-2 rounded-lg transition-all duration-300 shadow-sm hover:shadow-md"
        >
          <span class="hidden sm:inline">Financer ma formation</span><span class="sm:hidden">CPF</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.getElementById('navbar');
    const navbarCta = document.getElementById('navbar-cta');
    const heroCta = document.getElementById('hero-cta');
    const pricingCta = document.getElementById('pricing-cta');

    if (!navbar || !navbarCta) return;

    function updateNavbar() {
      const heroCtaRect = heroCta?.getBoundingClientRect();
      const pricingCtaRect = pricingCta?.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // Hide navbar ONLY when pricing CTA button is visible on screen
      // The button is visible if its top is above viewport bottom and bottom is below viewport top
      const pricingCtaVisible = pricingCtaRect &&
        pricingCtaRect.top < viewportHeight &&
        pricingCtaRect.bottom > 0;
      navbar.classList.toggle('navbar-hidden', pricingCtaVisible);

      // Show navbar CTA when hero CTA is scrolled out of view
      const heroCtaVisible = heroCtaRect && heroCtaRect.bottom > 80;
      navbarCta.classList.toggle('navbar-cta-hidden', heroCtaVisible);
      navbarCta.classList.toggle('navbar-cta-visible', !heroCtaVisible);
    }

    window.addEventListener('scroll', updateNavbar, { passive: true });
    updateNavbar();
  });
</script>

<style>
  #navbar {
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  #navbar.navbar-hidden {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  .navbar-cta-hidden {
    opacity: 0;
    transform: translateY(-10px) scale(0.95);
    pointer-events: none;
  }

  .navbar-cta-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
</style>
