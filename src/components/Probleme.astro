---
// Probleme section - Clean minimal cards with PAS framework
const painPoints = [
  {
    icon: "copy",
    title: "Copier-coller sans fin",
    description: "Excel vers CRM, CRM vers facture, facture vers comptable... Vous faites le travail d'un robot. Et à chaque erreur, vous recommencez."
  },
  {
    icon: "unplug",
    title: "Outils qui ne se parlent pas",
    description: "Slack, Notion, Airtable, Stripe... Vous avez 10 outils, mais aucun ne communique. Résultat : vous êtes le lien entre tous."
  },
  {
    icon: "clock",
    title: "10h/semaine sur du vide",
    description: "Pendant que vous copiez des données, vos concurrents automatisent et vendent. Chaque heure perdue, c'est du CA en moins."
  }
];
---

<section class="py-16 md:py-20">
  <div class="max-w-5xl mx-auto px-4 md:px-6">
    <!-- Header - minimal -->
    <div class="text-center mb-12">
      <p class="text-violet-600 text-xs font-medium tracking-wider uppercase mb-3">Le constat</p>
      <h2 class="text-2xl md:text-3xl font-semibold text-zinc-900 mb-3">
        Vous faites le travail d'un robot
      </h2>
      <p class="text-zinc-500 max-w-lg mx-auto">
        Et pendant ce temps, vos concurrents automatisent tout.
      </p>
    </div>

    <!-- Cards - light and minimal -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {painPoints.map((point) => (
        <div class="group p-5 rounded-xl border border-zinc-100 hover:border-zinc-200 hover:bg-zinc-50/50 transition-all">
          <!-- Icon -->
          <div class="w-9 h-9 rounded-lg bg-zinc-100 flex items-center justify-center mb-4 group-hover:bg-violet-100 transition-colors">
            {point.icon === "copy" && (
              <svg class="w-4 h-4 text-zinc-500 group-hover:text-violet-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
            )}
            {point.icon === "unplug" && (
              <svg class="w-4 h-4 text-zinc-500 group-hover:text-violet-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
              </svg>
            )}
            {point.icon === "clock" && (
              <svg class="w-4 h-4 text-zinc-500 group-hover:text-violet-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            )}
          </div>
          <h3 class="text-sm font-medium text-zinc-900 mb-1.5">{point.title}</h3>
          <p class="text-sm text-zinc-500 leading-relaxed">{point.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
